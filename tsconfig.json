{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024", "DOM"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "jsx": "react-jsx",
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "types": ["node", "react"], "declaration": true
  },
  "include": ["src", "tests"]
}
